# Copy to .env and supply only the provider credential you use. Never commit .env.

# --- LLM provider -----------------------------------------------------------
# openai | anthropic | gemini | ollama
#
# Ollama Cloud (hosted models, nothing runs locally) uses the OpenAI-compatible
# endpoint: keep LLM_PROVIDER=openai, point OPENAI_BASE_URL at ollama.com, and
# put your Ollama API key (ollama.com/settings/keys) in OPENAI_API_KEY.
# Free models include beam, nemotron-3-ultra, gpt-oss:120b; compare them with
#   python scripts/probe_models.py
LLM_PROVIDER=openai
LLM_MODEL=beam
OPENAI_BASE_URL=https://ollama.com/v1
# Paste a current key only in your ignored .env file.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=            # for LLM_PROVIDER=gemini (e.g. LLM_MODEL=gemini-2.5-flash)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_TEMPERATURE=0.1

# --- Agent runtime ------------------------------------------------------------
# crewai : every agent runs on CrewAI
# adk    : every agent runs on Google ADK (per-run session with state)
# hybrid : analysis + planning on ADK (session memory across analyse/plan/replan),
#          transformation + repair + test generation on CrewAI
AGENT_FRAMEWORK=hybrid
# Optional persistent ADK session store (SQLAlchemy URL). In-memory when unset.
# ADK_SESSION_DB_URL=sqlite:///runs/adk_sessions.db

# --- Budgets ----------------------------------------------------------------------
MAX_REPAIRS=5
MAX_NO_PROGRESS=2
MAX_REPLANS=1
MAX_TOKENS=500000
MAX_WALL_CLOCK_S=1800
MIN_BASELINE_PASSING_TESTS=5

# --- Sandbox --------------------------------------------------------------------
SANDBOX_CPUS=2
SANDBOX_MEM=2g
SANDBOX_CMD_TIMEOUT_S=300
ALLOW_DEPENDENCY_ROLLBACK_FALLBACK=false

# --- API limits -----------------------------------------------------------------
MAX_CONCURRENT_RUNS=2
MAX_UPLOAD_BYTES=209715200
MAX_ARCHIVE_UNCOMPRESSED_BYTES=1073741824
MAX_ARCHIVE_MEMBERS=50000
