# Copy to .env and supply only the provider credential you use. Never commit .env.

# --- LLM provider -----------------------------------------------------------
# openai | anthropic | gemini | ollama
#
# Ollama Cloud (hosted models, nothing runs locally) uses the OpenAI-compatible
# endpoint: keep LLM_PROVIDER=openai, point OPENAI_BASE_URL at ollama.com, and
# put your Ollama API key (ollama.com/settings/keys) in OPENAI_API_KEY.
# Free models include beam, nemotron-3-ultra, gpt-oss:120b; compare them with
#   python scripts/probe_models.py
LLM_PROVIDER=openai
LLM_MODEL=beam
OPENAI_BASE_URL=https://ollama.com/v1
# Paste a current key only in your ignored .env file.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=            # for LLM_PROVIDER=gemini (e.g. LLM_MODEL=gemini-2.5-flash)
# OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_TEMPERATURE=0.1

# --- Agent runtime ------------------------------------------------------------
# crewai : every agent runs on CrewAI
# adk    : every agent runs on Google ADK (per-run session with state)
# hybrid : analysis + planning on ADK (session memory across analyse/plan/replan),
#          transformation + repair + test generation on CrewAI
AGENT_FRAMEWORK=hybrid
# Optional persistent ADK session store (SQLAlchemy URL). In-memory when unset.
# ADK_SESSION_DB_URL=sqlite:///runs/adk_sessions.db

# --- Tools (MCP) and agent-to-agent (A2A) -----------------------------------------
# ReForge's MCP tool server (package registry lookups, dependency parsing,
# deprecated-pattern scans, read-only file access) is used by the analysis step
# and by the ADK and CrewAI agents. false disables it.
ENABLE_MCP=true
# Planning over A2A: compose.yaml points this at the a2a-planner service. Set it
# empty to run the planner in-process. Outside Docker use http://localhost:8002.
# A2A_PLANNER_URL=http://a2a-planner:8002

# --- Observability (LangFuse via OpenTelemetry) -------------------------------------
# Create a project at https://cloud.langfuse.com (or self-host) and paste its keys.
# With no keys, traces are still created (ids appear in reports) but not exported.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# The id in your LangFuse project URL (/project/<id>); enables "View trace" links.
LANGFUSE_PROJECT_ID=
# Alternative: any OTLP collector (Jaeger, Tempo, Phoenix...).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- Cost evaluation -----------------------------------------------------------------
# USD per million tokens for your model; 0 reports cost as "not priced".
# Ollama Cloud free models cost 0. Example for a paid model: 0.30 / 2.50.
LLM_INPUT_PRICE_PER_MTOK=0
LLM_OUTPUT_PRICE_PER_MTOK=0

# --- Human in the loop ---------------------------------------------------------
# true: every run pauses after planning until a person approves (all or some
# steps), requests changes, or rejects the plan in the dashboard. Benchmark
# suites always run unattended.
REQUIRE_PLAN_APPROVAL=true

# --- Budgets ----------------------------------------------------------------------
MAX_REPAIRS=5
MAX_NO_PROGRESS=2
MAX_REPLANS=1
MAX_TOKENS=500000
MAX_WALL_CLOCK_S=1800
MIN_BASELINE_PASSING_TESTS=5

# --- Sandbox --------------------------------------------------------------------
SANDBOX_CPUS=2
SANDBOX_MEM=2g
SANDBOX_CMD_TIMEOUT_S=300
ALLOW_DEPENDENCY_ROLLBACK_FALLBACK=false

# --- API limits -----------------------------------------------------------------
MAX_CONCURRENT_RUNS=2
MAX_UPLOAD_BYTES=209715200
MAX_ARCHIVE_UNCOMPRESSED_BYTES=1073741824
MAX_ARCHIVE_MEMBERS=50000
